; Energy Minimization for test run
integrator      = steep       ; Algorithm (steepest descent minimization)
emtol           = 1000.0      ; Stop minimization when max force < 1000.0 kJ/mol/nm
emstep          = 0.01        ; Step size
nsteps          = 5000        ; Maximum number of minimization steps

; Output control
nstenergy       = 10
energygrps      = System

; Neighborsearching
nstlist         = 1
cutoff-scheme   = Verlet
ns_type         = grid
rlist           = 1.0

; Electrostatics
coulombtype     = PME
rcoulomb        = 1.0

; van der Waals
vdwtype         = Cut-off
rvdw            = 1.0

; Apply periodic boundary conditions
pbc             = xyz
